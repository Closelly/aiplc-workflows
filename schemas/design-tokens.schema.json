{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-tokens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "background",
    "text",
    "surface",
    "accent",
    "fontFamily",
    "rationale"
  ],
  "properties": {
    "background": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "text": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "surface": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "accent": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "fontFamily": {
      "type": "string",
      "minLength": 2,
      "maxLength": 70,
      "pattern": "^[a-zA-Z0-9 -]+$"
    },
    "rationale": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4000
    }
  }
}
