{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "flows",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "user",
          "steps",
          "states",
          "screenshots",
          "accessibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "user": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 8,
              "maxLength": 4000
            },
            "minItems": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 8,
              "maxLength": 4000
            },
            "minItems": 1
          },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_./@ +()-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "accessibility": {
            "type": "string",
            "minLength": 8,
            "maxLength": 4000
          }
        }
      },
      "minItems": 1
    }
  }
}
