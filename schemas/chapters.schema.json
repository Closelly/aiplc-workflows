{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chapters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "language",
    "durationMs",
    "chapters"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "startMs",
          "endMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "category": {
            "enum": [
              "product",
              "prototype",
              "business",
              "marketing",
              "other"
            ]
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 4
    }
  }
}
