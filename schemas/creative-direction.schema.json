{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "creative-direction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected",
    "participant",
    "feedback",
    "rationale",
    "rejected"
  ],
  "properties": {
    "selected": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*$"
    },
    "participant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9_.@-]+$"
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 4000
      },
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4000
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 4000
          }
        }
      },
      "minItems": 2
    }
  }
}
