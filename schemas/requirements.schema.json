{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "source",
          "priority",
          "flows",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 4000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_./@ +()-]+$"
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "normal"
            ]
          },
          "flows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 8,
              "maxLength": 4000
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
