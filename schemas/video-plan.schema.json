{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "video-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "chapters"
  ],
  "properties": {
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "sources",
          "scenes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "category": {
            "enum": [
              "product",
              "prototype",
              "business",
              "marketing",
              "other"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_./@ +()-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "takeaway",
                "layout",
                "points",
                "narration"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80
                },
                "takeaway": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 130
                },
                "layout": {
                  "enum": [
                    "process",
                    "insight",
                    "prototype"
                  ]
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 65
                  },
                  "minItems": 2,
                  "maxItems": 4
                },
                "narration": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 155
                  },
                  "minItems": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9_./@ +()-]+$"
                },
                "focus": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 4
    }
  }
}
