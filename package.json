{
  "name": "closelly-aiplc-workflows",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Product definition and engineering readiness workflows",
  "bin": {
    "closelly-aiplc": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
